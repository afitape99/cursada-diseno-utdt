rules_version = '2';
// Todos leen todo. Cada persona edita solo la fila que creó: la fila guarda el id anónimo (ownerUid)
// del navegador desde el que se anotó, y nadie más puede cambiarla ni borrarla.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function validPerson(d) {
      return d.keys().hasOnly(['name', 'cuatri', 'cmDone', 'situacion', 'afuera', 'ownerUid', 'createdAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 40
        && d.cmDone is int && d.cmDone >= 0 && d.cmDone <= 3
        && (!('cuatri' in d) || (d.cuatri is int && d.cuatri >= 1 && d.cuatri <= 5))
        && (!('situacion' in d) || (d.situacion is string && d.situacion.size() <= 300))
        && (!('afuera' in d) || d.afuera in ['', 'c1', 'c2', 'c3', 'c4'])
        && d.ownerUid == request.auth.uid;
    }

    function ownsPerson(pid) {
      return getAfter(/databases/$(database)/documents/people/$(pid)).data.ownerUid == request.auth.uid;
    }

    match /people/{id} {
      allow read: if true;
      allow create: if signedIn() && validPerson(request.resource.data);
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid && validPerson(request.resource.data);
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /blocks/{id} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['personId', 'code', 'name', 'col', 'note', 'debe', 'opt'])
        && request.resource.data.personId is string && request.resource.data.personId.size() <= 40
        && request.resource.data.code is string && request.resource.data.code.size() <= 10
        && request.resource.data.col in ['c1', 'c2', 'c3', 'c4']
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 60))
        && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 300))
        && (resource == null || resource.data.personId == request.resource.data.personId)
        && ownsPerson(request.resource.data.personId);
      allow delete: if signedIn()
        && get(/databases/$(database)/documents/people/$(resource.data.personId)).data.ownerUid == request.auth.uid;
    }
  }
}
